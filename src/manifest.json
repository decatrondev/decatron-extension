{
  "manifest_version": 3,
  "name": "Decatron",
  "version": "0.2.2",
  "description": "Decatron en Twitch: escucha el stream en tu idioma y ve los emotes de 7TV, BTTV, FFZ y los de cada comunidad de Decatron, sin instalar otras extensiones.",
  "default_locale": "es",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://decatron.net/*",
    "https://7tv.io/*",
    "https://api.betterttv.net/*",
    "https://api.frankerfacez.com/*",
    "https://gql.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_title": "Decatron"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "i18n.js",
        "core.js",
        "kit.js",
        "signalr-lite.js",
        "audio.js",
        "captions-ui.js",
        "shell.js",
        "emote-picker.js",
        "modules/translation.js",
        "modules/emotes.js",
        "modules/points.js",
        "main.js"
      ],
      "css": [
        "player.css",
        "emotes.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css"
      ],
      "matches": [
        "https://www.twitch.tv/*"
      ]
    }
  ]
}
